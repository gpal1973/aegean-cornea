---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Aegean Cornea & Cataract XVIII | Ophthalmology Congress Corfu 2027';
const description = 'Aegean Cornea & Cataract XVIII is an international ophthalmology congress in Corfu, Greece, 1–4 July 2027, focused on cornea, cataract and refractive surgery.';
const socialDescription = 'International ophthalmology congress focused on cornea, cataract and refractive surgery · 1–4 July 2027 · Corfu, Greece';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Aegean Cornea & Cataract XVIII',
  startDate: '2027-07-01',
  endDate: '2027-07-04',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  description: 'Aegean Cornea & Cataract XVIII is an international ophthalmology congress in Corfu, Greece, focused on cornea, cataract and refractive surgery.',
  image: 'https://aegeancornea.com/assets/aegc-poster-xviii-web.webp',
  location: {
    '@type': 'Place',
    name: 'Corfu, Greece',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Corfu',
      addressCountry: 'GR',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Aegean Cornea & Cataract',
    url: 'https://aegeancornea.com/',
    email: 'aegean@med.uoc.gr',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'Congress enquiries',
        email: 'aegean@med.uoc.gr',
      },
      {
        '@type': 'ContactPoint',
        contactType: 'Congress coordination',
        email: 'eirkok@gmail.com',
      },
    ],
  },
  url: 'https://aegeancornea.com/',
};
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={socialDescription}
  twitterTitle="Aegean Cornea & Cataract XVIII | Corfu 2027"
  twitterDescription={socialDescription}
  preloadImage="/assets/aegc-corfu-hero.webp"
  structuredData={structuredData}
>
  <main class="shell">
    <section class="hero" aria-labelledby="event-title">
      <div class="hero-media" aria-hidden="true"></div>
      <div class="hero-inner">
        <a class="brand" href="/" aria-label="Aegean Cornea & Cataract home">
          <img src="/assets/aegc-logo-web.webp" alt="Aegean Cornea & Cataract logo" />
          <span>Aegean Cornea<br />& Cataract</span>
        </a>

        <div class="event-copy">
          <p class="eyebrow">XVIII Congress · Corfu 2027</p>
          <h1 id="event-title">Aegean Cornea <span>& Cataract XVIII</span></h1>
          <p class="date">1–4 July 2027</p>
          <p class="location">Corfu, Greece</p>
          <p class="intro">Aegean Cornea & Cataract XVIII brings together ophthalmologists in Corfu, Greece, for an international scientific meeting focused on cornea, cataract and refractive surgery. The congress takes place 1–4 July 2027, with programme, registration, venue and accommodation information to be announced.</p>
          <a class="button" href="#committee">Organizing Committee</a>
        </div>

        <p class="status">Official congress website · Updates coming soon</p>
      </div>
    </section>

    <section class="committee" id="committee" aria-labelledby="committee-title">
      <div class="section-heading">
        <p class="eyebrow">Corfu 2027</p>
        <h2 id="committee-title">Organizing Committee</h2>
      </div>
      <div class="names" role="list">
        <div role="listitem">Oliver Findl</div>
        <div role="listitem">George Kymionis</div>
        <div role="listitem">Marguerite McDonald</div>
        <div role="listitem">Ioannis Pallikaris</div>
        <div role="listitem">Sonia Yoo</div>
      </div>
    </section>

    <section class="updates" aria-labelledby="updates-title">
      <p class="eyebrow" data-reveal>Congress information</p>
      <h2 id="updates-title" data-reveal style="--reveal-delay: 60ms">Programme, registration & contact.</h2>
      <p data-reveal style="--reveal-delay: 120ms">Scientific programme, registration, venue and accommodation information will be published here as soon as they are confirmed.</p>

      <div class="contact-grid" aria-label="Congress contact details">
        <a class="contact-card" href="mailto:aegean@med.uoc.gr" data-reveal style="--reveal-delay: 180ms">
          <span class="contact-label">Official congress email</span>
          <strong>aegean@med.uoc.gr</strong>
          <span class="contact-note">General congress enquiries</span>
        </a>
        <a class="contact-card" href="mailto:eirkok@gmail.com" data-reveal style="--reveal-delay: 250ms">
          <span class="contact-label">Coordination contact</span>
          <strong>eirkok@gmail.com</strong>
          <span class="contact-note">Eirini Kokolaki · event coordination</span>
        </a>
      </div>
    </section>
  </main>

  <footer>
    <span>© Aegean Cornea & Cataract</span>
    <span><a href="mailto:aegean@med.uoc.gr">aegean@med.uoc.gr</a> · Corfu · Greece · 1–4 July 2027</span>
  </footer>

  <script>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      document.documentElement.classList.add('motion-ready');

      const revealItems = document.querySelectorAll('[data-reveal]');
      const revealObserver = new IntersectionObserver((entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }, {
        threshold: 0.14,
        rootMargin: '0px 0px -8% 0px',
      });

      revealItems.forEach((item) => revealObserver.observe(item));
    }
  </script>
</BaseLayout>
